            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "effect"
              ],
              "properties": {
                "effect": {
                  "$ref": "#/$defs/video_transform"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "video.transform.update"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "effect"
              ],
              "properties": {
                "effect": {
                  "$ref": "#/$defs/video_transform"
