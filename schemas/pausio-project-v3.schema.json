          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "video.transform.remove"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "effect_id"
              ],
              "properties": {
                "effect_id": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
