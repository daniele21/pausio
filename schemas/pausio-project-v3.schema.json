              "properties": {
                "transition_id": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        }
      ]
    },
    "audio_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_sha256",
        "filename",
        "start_ms",
        "duration_ms",
        "gain_db"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "start_ms": {
          "$ref": "#/$defs/ms"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180000
        },
        "gain_db": {
          "type": "integer",
          "minimum": -36,
          "maximum": 12
        },
        "muted": {
          "type": "boolean"
        }
