{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daniele21/pausio/blob/main/schemas/pausio-project-v3.schema.json",
  "title": "Pausio Portable Editing Project v3 — source-anchored visual FX",
  "description": "Extends v2 event tape with validated video.transform commands and keeps media binding, history cursor and revision. Imports v1/v2 continue to be supported by the reducer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "media",
    "commands",
    "history_cursor",
    "revision"
  ],
  "properties": {
    "format": {
      "const": "pausio.project"
    },
    "schema_version": {
      "const": 3,
      "type": "integer"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "duration_ms",
        "has_audio"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^/\\\\\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 172800000
        },
        "has_audio": {
          "type": "boolean"
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "history_cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "description": "Applied prefix length; remaining command tail is redo history."
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Monotonic project revision, increased by commands and undo/redo. Not the command count."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 172800000
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_ms",
        "end_ms"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start_ms": {
          "$ref": "#/$defs/ms"
        },
        "end_ms": {
          "$ref": "#/$defs/ms"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "analysis.propose"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "policy",
                "noise_db",
                "segments"
              ],
              "properties": {
                "engine": {
                  "const": "ffmpeg.silencedetect"
                },
                "policy": {
                  "const": "ai-natural"
                },
                "noise_db": {
                  "type": "integer",
                  "minimum": -90,
                  "maximum": -5
                },
                "segments": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 200,
                  "items": {
                    "$ref": "#/$defs/segment"
                  }
                },
                "settings": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "preset",
                    "noise_db",
                    "min_silence_ms",
                    "min_removed_ms",
                    "speech_padding_before_ms",
                    "speech_padding_after_ms",
                    "min_keep_ms"
                  ],
                  "properties": {
                    "preset": {
                      "type": "string",
                      "enum": [
                        "natural",
                        "balanced",
                        "dynamic",
                        "custom"
                      ]
                    },
                    "noise_db": {
                      "type": "integer",
                      "minimum": -55,
                      "maximum": -15
                    },
                    "min_silence_ms": {
                      "type": "integer",
                      "minimum": 200,
                      "maximum": 2000
                    },
                    "min_removed_ms": {
                      "type": "integer",
                      "minimum": 50,
                      "maximum": 1000
                    },
                    "speech_padding_before_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 600
                    },
                    "speech_padding_after_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 600
                    },
                    "min_keep_ms": {
                      "type": "integer",
                      "minimum": 50,
                      "maximum": 1000
                    }
                  }
                },
                "detected_silences": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "description": "Number of FFmpeg detected silence intervals before the cut policy."
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "settings"
                    ]
                  },
                  "then": {
                    "required": [
                      "detected_silences"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "detected_silences"
                    ]
                  },
                  "then": {
                    "required": [
                      "settings"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "timeline.replace"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segments"
              ],
              "properties": {
                "segments": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 200,
                  "items": {
                    "$ref": "#/$defs/segment"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "segment.update"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id",
                "start_ms",
                "end_ms"
              ],
              "properties": {
                "segment_id": {
                  "$ref": "#/$defs/id"
                },
                "start_ms": {
                  "$ref": "#/$defs/ms"
                },
                "end_ms": {
                  "$ref": "#/$defs/ms"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "segment.remove"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id"
              ],
              "properties": {
                "segment_id": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "segment.insert"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment"
              ],
              "properties": {
                "segment": {
                  "$ref": "#/$defs/segment"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "timeline.restore_suggestion"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "timeline.keep_all"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "timeline.approve"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "caption.set"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cues",
                "style"
              ],
              "properties": {
                "cues": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 500,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "start_ms",
                      "end_ms",
                      "text"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "start_ms": {
                        "$ref": "#/$defs/ms"
                      },
                      "end_ms": {
                        "$ref": "#/$defs/ms"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                },
                "style": {
                  "type": "string",
                  "enum": [
                    "social",
                    "minimal",
                    "boxed"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "caption.correct"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "caption_id",
                "text"
              ],
              "properties": {
                "caption_id": {
                  "$ref": "#/$defs/id"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "caption.retime"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "caption_id",
                "start_ms",
                "end_ms"
              ],
              "properties": {
                "caption_id": {
                  "$ref": "#/$defs/id"
                },
                "start_ms": {
                  "$ref": "#/$defs/ms"
                },
                "end_ms": {
                  "$ref": "#/$defs/ms"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "caption.style"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "style"
              ],
              "properties": {
                "style": {
                  "type": "string",
                  "enum": [
                    "social",
                    "minimal",
                    "boxed"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "caption.clear"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "caption.configure"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "config"
              ],
              "properties": {
                "config": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "preset",
                    "x_pct",
                    "y_pct",
                    "font_size",
                    "text_color",
                    "outline_color",
                    "outline_size",
                    "background",
                    "background_color"
                  ],
                  "properties": {
                    "preset": {
                      "type": "string",
                      "enum": [
                        "social",
                        "minimal",
                        "boxed",
                        "custom"
                      ]
                    },
                    "x_pct": {
                      "type": "integer",
                      "minimum": 15,
                      "maximum": 85
                    },
                    "y_pct": {
                      "type": "integer",
                      "minimum": 15,
                      "maximum": 85
                    },
                    "font_size": {
                      "type": "integer",
                      "minimum": 32,
                      "maximum": 100
                    },
                    "outline_size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "text_color": {
                      "type": "string",
                      "pattern": "^#[0-9A-F]{6}$"
                    },
                    "outline_color": {
                      "type": "string",
                      "pattern": "^#[0-9A-F]{6}$"
                    },
                    "background_color": {
                      "type": "string",
                      "pattern": "^#[0-9A-F]{6}$"
                    },
                    "background": {
                      "type": "boolean"
                    },
                    "font_family": {
                      "type": "string",
                      "enum": [
                        "Arial",
                        "Helvetica Neue",
                        "Avenir Next",
                        "Verdana",
                        "Georgia",
                        "Courier New",
                        "Impact",
                        "Times New Roman"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "audio.add"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clip"
              ],
              "properties": {
                "clip": {
                  "$ref": "#/$defs/audio_clip"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "audio.update"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clip_id",
                "start_ms",
                "gain_db"
              ],
              "properties": {
                "clip_id": {
                  "$ref": "#/$defs/id"
                },
                "start_ms": {
                  "$ref": "#/$defs/ms"
                },
                "gain_db": {
                  "type": "integer",
                  "minimum": -36,
                  "maximum": 12
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "audio.remove"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clip_id"
              ],
              "properties": {
                "clip_id": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "audio.mixer.configure"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "voice_gain_db",
                "voice_muted",
                "fx_gain_db",
                "fx_muted"
              ],
              "properties": {
                "voice_gain_db": {
                  "type": "integer",
                  "minimum": -36,
                  "maximum": 12
                },
                "voice_muted": {
                  "type": "boolean"
                },
                "fx_gain_db": {
                  "type": "integer",
                  "minimum": -36,
                  "maximum": 12
                },
                "fx_muted": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "audio.clip.mix"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clip_id",
                "gain_db",
                "muted"
              ],
              "properties": {
                "clip_id": {
                  "$ref": "#/$defs/id"
                },
                "gain_db": {
                  "type": "integer",
                  "minimum": -36,
                  "maximum": 12
                },
                "muted": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
