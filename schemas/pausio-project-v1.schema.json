{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daniele21/pausio/blob/main/schemas/pausio-project-v1.schema.json",
  "title": "Pausio Portable Editing Project v1",
  "description": "An ordered event tape, not a snapshot or a command execution language. Stateful validation and replay rules live in pausio.project_commands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "media",
    "commands"
  ],
  "properties": {
    "format": {
      "const": "pausio.project"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "duration_ms",
        "has_audio"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^/\\\\\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 172800000
        },
        "has_audio": {
          "type": "boolean"
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 172800000
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_ms",
        "end_ms"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start_ms": {
          "$ref": "#/$defs/ms"
        },
        "end_ms": {
          "$ref": "#/$defs/ms"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "analysis.propose"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "policy",
                "noise_db",
                "segments"
              ],
              "properties": {
                "engine": {
                  "const": "ffmpeg.silencedetect"
                },
                "policy": {
                  "const": "ai-natural"
                },
                "noise_db": {
                  "type": "integer",
                  "minimum": -90,
                  "maximum": -5
                },
                "segments": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 200,
                  "items": {
                    "$ref": "#/$defs/segment"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "timeline.replace"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segments"
              ],
              "properties": {
                "segments": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 200,
                  "items": {
                    "$ref": "#/$defs/segment"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "segment.update"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id",
                "start_ms",
                "end_ms"
              ],
              "properties": {
                "segment_id": {
                  "$ref": "#/$defs/id"
                },
                "start_ms": {
                  "$ref": "#/$defs/ms"
                },
                "end_ms": {
                  "$ref": "#/$defs/ms"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "segment.remove"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id"
              ],
              "properties": {
                "segment_id": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "segment.insert"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment"
              ],
              "properties": {
                "segment": {
                  "$ref": "#/$defs/segment"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "timeline.restore_suggestion"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "timeline.keep_all"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "payload"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "timeline.approve"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        }
      ]
    }
  }
}
