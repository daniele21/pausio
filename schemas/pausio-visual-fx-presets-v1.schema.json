{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daniele21/pausio/blob/main/schemas/pausio-visual-fx-presets-v1.schema.json",
  "title": "Pausio Visual FX Proposal Profiles v1 (design contract, not runtime engine)",
  "description": "Strict versioned controls for non-destructive FX proposals; schema validation does not itself implement effects.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pausio.visual_fx_presets"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "design_only_not_connected_to_renderer"
    },
    "default_profile": {
      "const": "naturale"
    },
    "selector_version": {
      "const": "weighted-gates-v1"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "naturale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "naturale",
                "educativo",
                "dinamico",
                "personalizzato"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "execution_mode": {
              "const": "suggest"
            },
            "allowed_moves": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "punch",
                  "slow_push",
                  "ratchet"
                ]
              },
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true
            },
            "cadence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_effects_per_minute": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 12
                },
                "min_gap_ms": {
                  "type": "integer",
                  "minimum": 1500,
                  "maximum": 30000
                },
                "min_segment_ms": {
                  "type": "integer",
                  "minimum": 500,
                  "maximum": 30000
                }
              },
              "required": [
                "max_effects_per_minute",
                "min_gap_ms",
                "min_segment_ms"
              ]
            },
            "zoom": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "punch_min_scale": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 1.3
                },
                "punch_max_scale": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 1.3
                },
                "punch_ramp_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "punch_hold_ms": {
                  "type": "integer",
                  "minimum": 150,
                  "maximum": 2500
                },
                "slow_push_max_scale": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 1.3
                },
                "slow_push_duration_ms": {
                  "type": "integer",
                  "minimum": 700,
                  "maximum": 15000
                }
              },
              "required": [
                "punch_min_scale",
                "punch_max_scale",
                "punch_ramp_ms",
                "punch_hold_ms",
                "slow_push_max_scale",
                "slow_push_duration_ms"
              ]
            },
            "transition": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowed_kinds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "hard_cut",
                      "dissolve",
                      "dip_black"
                    ]
                  },
                  "uniqueItems": true,
                  "minItems": 1,
                  "maxItems": 3
                },
                "max_per_minute": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 350
                },
                "context_change_only": {
                  "const": true
                }
              },
              "required": [
                "allowed_kinds",
                "max_per_minute",
                "duration_ms",
                "context_change_only"
              ]
            },
            "signals": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cut_boundary": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "phrase_boundary": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "speech_energy": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "face_stability": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "scene_change": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "semantic_marker": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "cut_boundary",
                "phrase_boundary",
                "speech_energy",
                "face_stability",
                "scene_change",
                "semantic_marker"
              ]
            },
            "guards": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "protect_manual_edits": {
                  "const": true
                },
                "protect_speech": {
                  "const": true
                },
                "face_margin_pct": {
                  "type": "number",
                  "minimum": 0.04,
                  "maximum": 0.2
                },
                "cut_guard_ms": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 1000
                },
                "minimum_source_width_px": {
                  "type": "integer",
                  "minimum": 360,
                  "maximum": 2160
                }
              },
              "required": [
                "protect_manual_edits",
                "protect_speech",
                "face_margin_pct",
                "cut_guard_ms",
                "minimum_source_width_px"
              ]
            }
          },
          "required": [
            "id",
            "label",
            "description",
            "execution_mode",
            "allowed_moves",
            "cadence",
            "zoom",
            "transition",
            "signals",
            "guards"
          ]
        },
